# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.0.2 Project Minimal Configuration
#
# default:
CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_FATFS_LFN_NONE=y
# INFO, not WARN. The boot path logs the PSRAM/heap snapshot and nvs_get_stats()
# at INFO, and those two lines are the whole point of the wear instrumentation --
# at WARN the device boots silently and there is nothing to look at. The runtime
# level is raised to uart_log_level a few lines into app_main anyway.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_COLORS=y
CONFIG_LWIP_IPV6=n
CONFIG_MBEDTLS_THREADING_C=n
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_MBEDTLS_LARGE_KEY_SOFTWARE_MPI=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_VFS_SUPPORT_TERMIOS=y

# --- Project-specific settings (added during the IDF 5.3 -> 6.0 migration) ---

# The module carries 16 MB of flash (Winbond ef:4018), not the 2 MB the project
# previously declared. Everything above 0x110000 was unreachable as a result.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The module also carries 8 MB of embedded PSRAM (ESP32-S3R8, octal) which was
# never enabled, so heap_caps reported a PSRAM total of zero.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Pin log format v1 explicitly. log_streamer.cpp intercepts esp_log output and
# parses the human-readable "I (56) tag: msg" form by hand in parse_log_line();
# switching to the v2 format would break that parsing silently, with no build
# error. v1 is still the IDF 6 default, but that is not something to rely on.
CONFIG_LOG_VERSION_1=y

# Custom 16 MB partition table with two 3 MB OTA slots. See partitions.csv for
# why the original NVS region at 0x9000 is left unmapped.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Boot a freshly written OTA image in the pending-verify state and roll back to
# the previous slot unless the app calls esp_ota_mark_app_valid_cancel_rollback().
# The device lives inside a sealed curing chamber, so an image that cannot reach
# the network has to undo itself rather than wait to be recovered over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ThingsBoard sends shared attributes and OTA metadata as single JSON payloads
# that exceed the 1 KB default. mqtt.cpp reassembles fragments regardless, but a
# buffer that fits the common case avoids the churn.
CONFIG_MQTT_BUFFER_SIZE=4096
