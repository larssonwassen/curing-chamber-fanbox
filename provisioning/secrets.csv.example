# NVS partition-generator input for the "provision" namespace.
#
# Copy to secrets.csv, fill in your own values, and run ./provision.sh. The real
# secrets.csv is gitignored -- nothing in this directory that carries a
# credential is ever committed, and nothing here is compiled into the firmware.
#
# tb_uri selects the transport by its scheme: mqtt:// is plaintext on 1883,
# mqtts:// verifies the broker against the bundled root CAs (usually :8883).
key,type,encoding,value
provision,namespace,,
wifi_ssid,data,string,YOUR_WIFI_SSID
wifi_psk,data,string,YOUR_WIFI_PASSWORD
tb_uri,data,string,mqtt://your-thingsboard-host
tb_token,data,string,YOUR_THINGSBOARD_ACCESS_TOKEN
