# ESP-IDF build output
build/

# Fetched by the IDF Component Manager from main/idf_component.yml.
# dependencies.lock is committed so builds are reproducible.
managed_components/

# Generated from sdkconfig.defaults by the build. Machine-specific, churns
# constantly, and is where credentials would otherwise end up committed.
sdkconfig
sdkconfig.old

# Written by CI so the build container does not have to run git. A local build
# derives the version from git describe instead.
version.txt

# Host test binaries (test/host/Makefile)
test/host/test_*
!test/host/test_*.cpp
*.dSYM/

# Provisioning inputs and generated NVS images. These carry real credentials;
# only secrets.csv.example is committed.
provisioning/secrets.csv
provisioning/*.bin
